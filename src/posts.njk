---
layout: layouts/base.njk
title: Posts
permalink: /posts/
---
<h1>Posts</h1>
{% set posts = collections.posts | reverse %}
{% if posts and posts.length %}
<ul>
  {% for post in posts %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a> - {{ post.date | readableDate }}</li>
  {% endfor %}
</ul>
{% else %}
<p>No posts yet.</p>
{% endif %}