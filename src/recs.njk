---
layout: layouts/base.njk
title: Recs
permalink: /recs/
---
<h1>Recommendations</h1>
{% set recItems = collections.recs | reverse %}
{% if recItems and recItems.length %}
<ul>
	{% for rec in recItems %}
	<li>
		{% if rec.data.url %}
		<a href="{{ rec.data.url }}" target="_blank" rel="noopener noreferrer">{{ rec.data.title }}</a>
		{% else %}
		{{ rec.data.title }}
		{% endif %}
		{% if rec.date %} — {{ rec.date | readableDate }}{% endif %}
		{% if rec.templateContent %}
		<p>{{ rec.templateContent | safe }}</p>
		{% endif %}
	</li>
	{% endfor %}
</ul>
{% else %}
<p>No recommendations yet.</p>
{% endif %}
