<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <script>
      (function () {
        var storageKey = "theme-preference";
        var hour = new Date().getHours();
        var isNight = hour >= 19 || hour < 7;
        var storedTheme = null;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch (error) {
          storedTheme = null;
        }

        var theme = storedTheme === "dark" || storedTheme === "light"
          ? storedTheme
          : (isNight ? "dark" : "light");

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/assets/styles/main.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header" aria-label="Site">
      <nav class="site-nav" aria-label="Primary">
        {% for item in nav %}
          <a {% if page.url == item.url %}aria-current="page"{% endif %} href="{{ item.url }}">{{ item.label }}</a>
        {% endfor %}
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
          Dark mode
        </button>
      </nav>
    </header>
    <main id="content" class="content">{{ content | safe }}</main>
    <script>
      (function () {
        var storageKey = "theme-preference";
        var root = document.documentElement;
        var button = document.querySelector(".theme-toggle");

        if (!button) {
          return;
        }

        function applyTheme(theme) {
          var isDark = theme === "dark";
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          button.setAttribute("aria-pressed", String(isDark));
          button.textContent = isDark ? "Light mode" : "Dark mode";
        }

        applyTheme(root.dataset.theme || "light");

        button.addEventListener("click", function () {
          var nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          applyTheme(nextTheme);

          try {
            localStorage.setItem(storageKey, nextTheme);
          } catch (error) {
          }
        });
      })();
    </script>
    <script>
      (function () {
        var content = document.querySelector(".content");
        if (!content) return;

        var h1 = content.querySelector("h1");
        var toc = content.querySelector(".toc");
        // Build a layout shell if the page has either a table of contents or sidenotes.
        var noteData = Array.from(content.querySelectorAll(".sidenote, .sidenote-data"));
        var hasNotes = noteData.length > 0;
        var hasToc = h1 && toc && toc.parentNode === content;

        if (hasToc || hasNotes) {
          var shell = content.querySelector(".post-shell");
          var main;

          if (!shell) {
            shell = document.createElement("div");
            shell.className = "post-shell";

            main = document.createElement("div");
            main.className = "post-main";
            shell.appendChild(main);

            // Move all existing content into the new main container.
            while (content.firstChild) {
              main.appendChild(content.firstChild);
            }

            content.appendChild(shell);
          } else {
            main = shell.querySelector(".post-main");
          }

          if (hasToc) {
            var tocAside = shell.querySelector(".post-toc");
            if (!tocAside) {
              tocAside = document.createElement("aside");
              tocAside.className = "post-toc";
              shell.insertBefore(tocAside, main);
            }
            tocAside.appendChild(toc);
            content.classList.add("has-side-toc");
          }

          if (hasNotes) {
            var notesAside = shell.querySelector(".post-sidenotes");
            if (!notesAside) {
              notesAside = document.createElement("aside");
              notesAside.className = "post-sidenotes";
              shell.appendChild(notesAside);
            }

            content.classList.add("has-side-notes");

            var list = document.createElement("div");
            list.className = "sidenotes";

            noteData.forEach(function (note, idx) {
              var id = note.dataset.sidenoteId || String(idx);
              var number = idx + 1;

              var item = document.createElement("div");
              item.className = "sidenote-item";
              item.id = "sn-" + id;

              var label = document.createElement("span");
              label.className = "sidenote-label";
              label.textContent = number + ".";

              var body = document.createElement("div");
              body.className = "sidenote-body";
              body.innerHTML = note.innerHTML;

              var back = document.createElement("a");
              back.className = "sidenote-backref";
              back.href = "#snref-" + id;
              back.textContent = "↩";

              item.appendChild(label);
              item.appendChild(body);
              item.appendChild(back);

              var ref = document.querySelector("#snref-" + id + " a");
              if (ref) ref.textContent = number;

              list.appendChild(item);
              note.remove();
            });

            notesAside.innerHTML = "";
            notesAside.appendChild(list);
          }
        }

        var h2s = Array.from(content.querySelectorAll("h2"));
        if (!h2s.length) return;

        h2s.forEach(function (h2) {
          if (h2.closest("summary")) return;
          var details = document.createElement("details");
          details.className = "collapsible-section";
          details.open = true;
          var summary = document.createElement("summary");
          h2.parentNode.insertBefore(details, h2);
          summary.appendChild(h2);
          details.appendChild(summary);
          var next = details.nextSibling;
          while (next) {
            var tag = next.tagName;
            if (tag === "H1" || tag === "H2") break;
            var move = next;
            next = next.nextSibling;
            details.appendChild(move);
          }
        });

        function openFromHash() {
          var hash = window.location.hash;
          if (!hash) return;
          try {
            var target = document.querySelector(hash);
            if (!target) return;
            var el = target;
            while (el && el !== content) {
              if (el.tagName === "DETAILS") el.open = true;
              el = el.parentElement;
            }
            setTimeout(function () { target.scrollIntoView(); }, 0);
          } catch (e) {}
        }

        openFromHash();
        window.addEventListener("hashchange", openFromHash);
      })();
    </script>
  </body>
</html>
