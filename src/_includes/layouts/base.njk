<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href="/assets/icons/favicons/light/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href="/assets/icons/favicons/light/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="/assets/icons/favicons/dark/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" href="/assets/icons/favicons/dark/favicon-16x16.png" />
    <link rel="shortcut icon" href="/assets/icons/favicons/light/favicon.ico" />
    <link rel="apple-touch-icon" media="(prefers-color-scheme: light)" href="/assets/icons/favicons/light/apple-touch-icon.png" />
    <link rel="apple-touch-icon" media="(prefers-color-scheme: dark)" href="/assets/icons/favicons/dark/apple-touch-icon.png" />
    <script>
      (function () {
        var storageKey = "theme-mode";
        var root = document.documentElement;

        function getSystemBaseTheme() {
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;

          if (prefersLight || prefersDark) {
            return prefersDark ? "dark" : "light";
          }

          var hour = new Date().getHours();
          return hour >= 19 || hour < 7 ? "dark" : "light";
        }

        function applyTheme(theme) {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        }

        var storedMode = null;
        try {
          storedMode = localStorage.getItem(storageKey);
        } catch (error) {
          storedMode = null;
        }

        var mode = storedMode === "light" || storedMode === "dark" || storedMode === "system" ? storedMode : "system";
        applyTheme(mode === "system" ? getSystemBaseTheme() : mode);
      })();
    </script>
    <link rel="stylesheet" href="/assets/styles/main.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header" aria-label="Site">
      <nav class="site-nav" aria-label="Primary">
        {% for item in nav %}
          <a {% if page.url == item.url %}aria-current="page"{% endif %} href="{{ item.url }}">{{ item.label }}</a>
        {% endfor %}
        <label for="theme-mode-select" class="theme-mode-label">
          Theme:
          <select id="theme-mode-select" class="theme-mode" aria-label="Theme mode">
            <option value="system">System</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </nav>
    </header>
    <main id="content" class="content">{{ content | safe }}</main>
    <script>
      (function () {
        var storageKey = "theme-mode";
        var root = document.documentElement;
        var select = document.getElementById("theme-mode-select");

        function getSystemBaseTheme() {
          var isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (window.matchMedia("(prefers-color-scheme: light)").matches || window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return isDark ? "dark" : "light";
          }

          var hour = new Date().getHours();
          return hour >= 19 || hour < 7 ? "dark" : "light";
        }

        function applyTheme(theme) {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          if (window.setFavicon) {
            window.setFavicon(theme);
          }
        }

        function updateThemeFromMode(mode) {
          var theme = mode;
          if (mode === "system") {
            theme = getSystemBaseTheme();
          }
          applyTheme(theme);
        }

        function setMode(mode) {
          if (!select) return;
          select.value = mode;

          try {
            localStorage.setItem(storageKey, mode);
          } catch (error) {
          }

          updateThemeFromMode(mode);
        }

        if (!select) {
          return;
        }

        var storedMode = null;
        try {
          storedMode = localStorage.getItem(storageKey);
        } catch (error) {
          storedMode = null;
        }

        if (storedMode !== "system" && storedMode !== "light" && storedMode !== "dark") {
          storedMode = "system";
        }

        setMode(storedMode);

        select.addEventListener("change", function () {
          setMode(select.value);
        });

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
          if (select.value === "system") {
            updateThemeFromMode("system");
          }
        });
      })();
    </script>
    <script>
      (function () {
        var content = document.querySelector(".content");
        if (!content) return;

        var h1 = content.querySelector("h1");
        var toc = content.querySelector(".toc");
        // Build a layout shell if the page has either a table of contents or sidenotes.
        var noteData = Array.from(content.querySelectorAll(".sidenote, .sidenote-data"));
        var hasNotes = noteData.length > 0;
        var hasToc = h1 && toc && toc.parentNode === content;

        if (hasNotes) {
          content.classList.add("has-side-notes");
        }

        if (hasToc) {
          var shell = document.createElement("div");
          shell.className = "post-shell";
          var main = document.createElement("div");
          main.className = "post-main";
          var aside = document.createElement("aside");
          aside.className = "post-toc";
          aside.appendChild(toc);
          shell.appendChild(aside);
          shell.appendChild(main);

          content.insertBefore(shell, h1);
          main.appendChild(h1);

          var next = shell.nextSibling;
          while (next) {
            var move = next;
            next = next.nextSibling;
            main.appendChild(move);
          }

          content.classList.add("has-side-toc");
        }

        var h2s = Array.from(content.querySelectorAll("h2"));
        if (!h2s.length) return;

        h2s.forEach(function (h2) {
          if (h2.closest("summary")) return;
          var details = document.createElement("details");
          details.className = "collapsible-section";
          details.open = true;
          var summary = document.createElement("summary");
          h2.parentNode.insertBefore(details, h2);
          summary.appendChild(h2);
          details.appendChild(summary);
          var next = details.nextSibling;
          while (next) {
            var tag = next.tagName;
            if (tag === "H1" || tag === "H2") break;
            var move = next;
            next = next.nextSibling;
            details.appendChild(move);
          }
        });

        function openFromHash() {
          var hash = window.location.hash;
          if (!hash) return;
          try {
            var target = document.querySelector(hash);
            if (!target) return;
            var el = target;
            while (el && el !== content) {
              if (el.tagName === "DETAILS") el.open = true;
              el = el.parentElement;
            }
            setTimeout(function () { target.scrollIntoView(); }, 0);
          } catch (e) {}
        }

        openFromHash();
        window.addEventListener("hashchange", openFromHash);

        // Sidenote behaviour:
        //   Narrow screens  → intercept the <a> click, show tooltip bubble.
        //   Wide screens    → let the <a href="#fn-N"> link work naturally;
        //                     the :target CSS rule briefly highlights the note.
        var narrowQuery = window.matchMedia("(max-width: 66rem)");
        document.querySelectorAll(".sidenote-link").forEach(function (link) {
          link.addEventListener("click", function (e) {
            if (!narrowQuery.matches) return; // wide: normal link navigation
            e.preventDefault();
            e.stopPropagation();
            var container = link.closest(".sidenote-container");
            if (!container) return;
            var isOpen = container.classList.contains("open");
            document.querySelectorAll(".sidenote-container.open").forEach(function (c) {
              c.querySelector(".sidenote").style.removeProperty("--tooltip-nudge");
              c.classList.remove("open");
            });
            if (!isOpen) {
              container.classList.add("open");
              // Nudge the tooltip so it stays within the viewport
              requestAnimationFrame(function () {
                var tip = container.querySelector(".sidenote");
                if (!tip) return;
                var rect = tip.getBoundingClientRect();
                var margin = 8;
                var nudge = 0;
                if (rect.left < margin) {
                  nudge = margin - rect.left;
                } else if (rect.right > window.innerWidth - margin) {
                  nudge = (window.innerWidth - margin) - rect.right;
                }
                if (nudge !== 0) tip.style.setProperty("--tooltip-nudge", nudge + "px");
              });
            }
          });
        });
        // Tap anywhere else closes open notes
        document.addEventListener("click", function () {
          document.querySelectorAll(".sidenote-container.open").forEach(function (c) {
            c.classList.remove("open");
          });
        });
      })();
    </script>
  </body>
</html>
